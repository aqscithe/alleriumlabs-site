---
import '../styles/global.css';
import ConnectSection from '../components/ConnectSection.astro';
import logo from '../assets/img/full-logo/Logo_High_White_text.png';

// Get latest devlog entries
const devlogEntries = await Astro.glob('../devlogs/*.md');
const latestDevlogs = devlogEntries
  .filter(entry => entry.frontmatter && entry.frontmatter.date && entry.frontmatter.title)
  .sort((a, b) => {
    const dateA = new Date(a.frontmatter.date);
    const dateB = new Date(b.frontmatter.date);
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, 3); // Get latest 3 entries

// Function to format date
function formatDate(dateString: string) {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long'
  });
}

// A few interesting stills for the Current Project teaser. Full showcase lives
// on /the-facility. Media is served from the general content bucket; missing
// files degrade gracefully to a labelled placeholder (see onerror handlers).
// TODO: swap placeholder filenames for real ones from the bucket.
const CONTENT_BASE = 'https://alleriumlabs-general-content.s3.us-west-2.amazonaws.com';
const teaserShots = [
  { file: 'test-space-img-1.jpg', alt: 'The Facility — in-engine still' },
];

// Sections the left-hand tracker steps through (in page order). The hero is
// intentionally excluded — the tracker only appears once you've scrolled past it.
const trackerSections = [
  { id: 'currentProject', label: 'The Facility' },
  { id: 'devlogSection', label: 'Devlog' },
  { id: 'connectSection', label: 'Connect' },
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <title>Allerium Labs - Game Studio</title>
    <meta name="description" content="Innovative game studio creating immersive experiences at the intersection of technology and human creativity." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <main>
		<!-- Hero Section with Logo -->
		<section class="hero-section" id="heroSection">
			<div class="hero-content">
				<!-- Logo will be rendered by fallback -->
			</div>
		</section>

		<!-- Current Project Teaser -->
		<section class="project-section current-project" id="currentProject">
			<div class="container">
				<div class="teaser-head">
					<p class="teaser-eyebrow">Current Project</p>
					<h2>The Facility</h2>
					<p class="teaser-subtitle">The Facility is an immersive sim horror game that takes place on the remains of a science research station in deep space, in orbit of a seemingly habitable planet.</p>
				</div>

				<div class="teaser-gallery">
					{teaserShots.map((shot) => (
						<figure class="teaser-shot">
							<img
								src={`${CONTENT_BASE}/image/${shot.file}`}
								alt={shot.alt}
								loading="lazy"
								onerror="this.closest('.teaser-shot')?.classList.add('shot-missing'); this.remove();"
							/>
							<div class="shot-fallback">Media coming soon</div>
						</figure>
					))}
				</div>

				<div class="teaser-cta">
					<a href="/games/the-facility" class="devlog-view-all">Explore The Facility →</a>
				</div>
			</div>
		</section>

		<!-- Development Blog Section -->
		<section class="devlog-section" id="devlogSection">
			<div class="container">
				<h2>Development Blog</h2>
				<p>Follow our monthly progress and behind-the-scenes development journey</p>
				
				{latestDevlogs.length > 0 ? (
					<div class="devlog-grid">
						{latestDevlogs.map((entry) => {
							const slug = entry.file.split('/').pop()?.replace('.md', '');
							return (
								<a href={`/devlog/${slug}`} class="devlog-card">
									<div class="devlog-card-bg" style={`background-image: url(${entry.frontmatter.image || '/img/webgpu.png'})`}></div>
									<div class="devlog-card-content">
										<div class="devlog-card-date">{formatDate(entry.frontmatter.date)}</div>
										<h3>{entry.frontmatter.title}</h3>
										<p>{entry.frontmatter.excerpt}</p>
										<div class="devlog-card-tags">
											{entry.frontmatter.tags && entry.frontmatter.tags.slice(0, 3).map((tag: string) => (
												<span class="devlog-tag">{tag}</span>
											))}
										</div>
									</div>
								</a>
							);
						})}
					</div>
				) : (
					<div class="devlog-placeholder">
						<p>Development blog posts coming soon!</p>
					</div>
				)}
				
				<div class="devlog-cta">
					<a href="/devlog" class="devlog-view-all">View All Posts</a>
				</div>
			</div>
		</section>

		<!-- Connect Section (shared component, also used on /devlog and /games/the-facility) -->
		<ConnectSection />

		<!-- Footer Section -->
		<footer class="footer-section">
			<div class="container">
				<div class="footer-content">
					<p>&copy; 2025 Allerium Labs. All rights reserved.</p>
					<p>Allerium Labs logo &copy; 2025 Allerium Labs. All rights reserved.</p>
				</div>
			</div>
		</footer>
    </main>

    <!-- Fixed section tracker: appears after the hero. Shows the current section
         (prominent, centered) with its neighbours dimmed above/below; click to jump.
         The old section-info widget is preserved in src/components/InfoWidget.astro. -->
    <nav class="section-tracker" id="sectionTracker" aria-label="Jump to section">
      <ul>
        {trackerSections.map((s) => (
          <li>
            <button type="button" class="section-tracker__item" data-target={s.id}>{s.label}</button>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Scripts -->
    <!-- <script src="../scripts/landing.js"></script> -->
    <!-- <script src="../scripts/helloTriangle.ts"></script> -->
    <script src="../scripts/particleLogo.ts"></script>

    <script>
      // Section tracker: a fixed, center-left indicator of the section currently
      // in view. The active section sits in the middle (white, prominent); its
      // immediate neighbours show above/below, smaller and dimmed. Clicking any
      // of them scrolls to the top of that section. Hidden over the hero.
      const tracker = document.getElementById('sectionTracker');
      const items = Array.from(
        document.querySelectorAll<HTMLButtonElement>('.section-tracker__item')
      );
      const ids = items
        .map((b) => b.dataset.target)
        .filter((id): id is string => Boolean(id));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Mark the active item plus its neighbours; everything else is hidden by CSS.
      function setCurrent(id: string): void {
        const idx = ids.indexOf(id);
        if (idx === -1) return;
        items.forEach((item, i) => {
          item.classList.toggle('is-current', i === idx);
          item.classList.toggle('is-prev', i === idx - 1);
          item.classList.toggle('is-next', i === idx + 1);
          if (i === idx) {
            item.setAttribute('aria-current', 'true');
          } else {
            item.removeAttribute('aria-current');
          }
        });
      }

      const sectionEls = ids
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

      // rootMargin pins the trigger line to the viewport's vertical centre, so
      // exactly one section is "intersecting" at a time — the one under the middle.
      const trackObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) setCurrent(entry.target.id);
          });
        },
        { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
      );
      sectionEls.forEach((el) => trackObserver.observe(el));

      // Reveal only once the hero/header has scrolled out of view.
      const hero = document.getElementById('heroSection');
      if (hero && tracker) {
        const heroObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              tracker.classList.toggle('visible', !entry.isIntersecting);
            });
          },
          { threshold: 0.15 }
        );
        heroObserver.observe(hero);
      }

      // Click a section → scroll to its top.
      items.forEach((item) => {
        item.addEventListener('click', () => {
          const id = item.dataset.target;
          const target = id ? document.getElementById(id) : null;
          if (!target) return;
          target.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'start',
          });
        });
      });

      // Seed initial state.
      if (ids.length) setCurrent(ids[0]);
    </script>
  </body>
</html>