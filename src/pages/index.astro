								<span class="social-badge">Under Construction</span>
							</div>
						</div>
					</div>

					<div class="connect-category">
						<h3>Get Involved</h3>
						<div class="involvement-options">
							<div class="option-card">
								<a href="/contact" class="cta-button">Join the Team</a>
								<a href="/contact" class="cta-button">Support Our Work</a>
								<a href="/contact" class="cta-button">Say Hi</a>
							</div>
						</div>
					</div>
				</div>
			</div>
