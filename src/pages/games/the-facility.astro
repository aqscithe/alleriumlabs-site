---
import '../../styles/global.css';
import '../../styles/the-facility.css';
import ConnectSection from '../../components/ConnectSection.astro';

// ---------------------------------------------------------------------------
// The "Work in Progress" puzzle is populated at runtime from the general
// content bucket — NOT hard-coded. A content manager just uploads files to the
// bucket's image/ , gif/ and video/ folders and they appear on next page load
// (newest first). No code change or rebuild required.
//
//   Bucket: https://alleriumlabs-general-content.s3.us-west-2.amazonaws.com
//   (distinct from the devlog content bucket, alleriumlabs-devlog-content)
//
// This requires the bucket to allow anonymous listing (s3:ListBucket) and a
// CORS rule permitting GET from the site origin. See src/pages/games/_GAMES.md.
//
// NOTE: A "From the Devlog" section is intentionally hidden for now (see git
// history to restore it). We only showcase shipped / in-progress work here.
// ---------------------------------------------------------------------------

// og:image: a dynamic page has no single hero file, so fall back to the logo.
const ogImage = '/img/Logo_High_White_text.png';

const pageTitle = 'The Facility - Allerium Labs';
const pageDescription =
  'A look at Project Codename: The Facility — a survival horror / immersive sim in development at Allerium Labs.';
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
  </head>

  <body>
    <main class="facility-main">
      <div class="container">
        <nav class="facility-nav">
          <a href="/" class="back-link">← Home</a>
          <div class="nav-links">
            <a href="/devlog">Devlog</a>
            <a href="/contact">Contact</a>
          </div>
        </nav>
      </div>

      <!-- Brief intro: what The Facility is -->
      <section class="facility-intro">
        <div class="container">
          <p class="eyebrow">Current Project</p>
          <h1>The Facility</h1>
          <p class="lede">
            The Facility is an immersive sim horror game that takes place on the
            remains of a science research station in deep space, in orbit of a
            seemingly habitable planet.
          </p>
        </div>
      </section>

      <!-- In-progress media puzzle (populated from the bucket at runtime) -->
      <section class="facility-section tone-a">
        <div class="container">
          <div class="section-head">
            <h2>Work in Progress</h2>
            <p>Images, gifs and clips captured straight from the project as it develops.</p>
          </div>

          <div class="puzzle-grid" id="puzzleGrid"></div>
          <p class="puzzle-status" id="puzzleStatus">Loading the latest…</p>
        </div>
      </section>

      <!-- Connect Section (shared component) -->
      <ConnectSection />

      <footer class="facility-footer">
        <div class="container">
          <p>&copy; 2025 Allerium Labs. All rights reserved.</p>
        </div>
      </footer>
    </main>

    <!-- Lightbox: click any puzzle item to expand -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Media viewer">
      <button class="lightbox-close" id="lightboxClose" aria-label="Close">&times;</button>
      <div class="lightbox-content" id="lightboxContent"></div>
    </div>

    <script>
      // ======================================================================
      // Work In Progress puzzle — pulled live from the S3 bucket listing.
      // ======================================================================
      const CONTENT_BASE =
        'https://alleriumlabs-general-content.s3.us-west-2.amazonaws.com';

      type Kind = 'image' | 'gif' | 'video';

      // Which folders to read, and which file types count as which kind.
      const SOURCES: { prefix: string; kind: Kind; exts: string[] }[] = [
        { prefix: 'image/', kind: 'image', exts: ['jpg', 'jpeg', 'png', 'webp', 'avif'] },
        { prefix: 'gif/', kind: 'gif', exts: ['gif'] },
        { prefix: 'video/', kind: 'video', exts: ['mp4', 'webm', 'mov', 'm4v'] },
      ];

      interface Piece {
        kind: Kind;
        url: string;
        label: string;
        modified: number;
      }

      const VIDEO_MIME: Record<string, string> = {
        mp4: 'video/mp4',
        webm: 'video/webm',
        mov: 'video/quicktime',
        m4v: 'video/x-m4v',
      };

      // Icon per content type (framed picture / loop / play). aria-hidden on the
      // svg; the badge itself carries an aria-label for screen readers.
      const ICONS: Record<Kind, string> = {
        image:
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>',
        gif:
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m17 2 4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>',
        video:
          '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>',
      };

      const KIND_LABEL: Record<Kind, string> = { image: 'Image', gif: 'GIF', video: 'Video' };

      const extOf = (key: string) => key.split('.').pop()?.toLowerCase() ?? '';

      // Build a fetch-safe URL, encoding each path segment (handles spaces etc.).
      const urlForKey = (key: string) =>
        `${CONTENT_BASE}/${key.split('/').map(encodeURIComponent).join('/')}`;

      // Turn "image/old-lab-corridor.jpg" → "Old lab corridor".
      function labelFromKey(key: string, prefix: string): string {
        const name = key.slice(prefix.length).replace(/\.[^.]+$/, '');
        const words = name.replace(/[-_]+/g, ' ').trim();
        return words ? words.charAt(0).toUpperCase() + words.slice(1) : name;
      }

      // List one folder, following pagination (S3 returns ≤1000 keys per call).
      async function listPrefix(source: (typeof SOURCES)[number]): Promise<Piece[]> {
        const pieces: Piece[] = [];
        let token = '';
        do {
          const url = new URL(`${CONTENT_BASE}/`);
          url.searchParams.set('list-type', '2');
          url.searchParams.set('prefix', source.prefix);
          if (token) url.searchParams.set('continuation-token', token);

          const res = await fetch(url.toString());
          if (!res.ok) throw new Error(`List ${source.prefix} → HTTP ${res.status}`);

          const doc = new DOMParser().parseFromString(await res.text(), 'text/xml');
          Array.from(doc.getElementsByTagName('Contents')).forEach((node) => {
            const key = node.getElementsByTagName('Key')[0]?.textContent ?? '';
            const size = node.getElementsByTagName('Size')[0]?.textContent ?? '0';
            const mod = node.getElementsByTagName('LastModified')[0]?.textContent ?? '';
            // Skip folder placeholder objects and wrong file types.
            if (!key || key.endsWith('/') || size === '0') return;
            if (!source.exts.includes(extOf(key))) return;
            pieces.push({
              kind: source.kind,
              url: urlForKey(key),
              label: labelFromKey(key, source.prefix),
              modified: Date.parse(mod) || 0,
            });
          });

          const truncated =
            doc.getElementsByTagName('IsTruncated')[0]?.textContent === 'true';
          token = truncated
            ? doc.getElementsByTagName('NextContinuationToken')[0]?.textContent ?? ''
            : '';
        } while (token);
        return pieces;
      }

      // ----- Build a tile -----
      function createItem(piece: Piece): HTMLElement {
        const fig = document.createElement('figure');
        fig.className = 'puzzle-item';

        const inner = document.createElement('div');
        inner.className = 'puzzle-inner';

        const badge = document.createElement('span');
        badge.className = 'media-badge';
        badge.setAttribute('role', 'img');
        badge.setAttribute('aria-label', KIND_LABEL[piece.kind]);
        badge.title = KIND_LABEL[piece.kind];
        badge.innerHTML = ICONS[piece.kind];
        inner.appendChild(badge);

        let mediaEl: HTMLImageElement | HTMLVideoElement;
        if (piece.kind === 'video') {
          const video = document.createElement('video');
          video.muted = true;
          video.loop = true;
          video.autoplay = true;
          video.playsInline = true;
          video.preload = 'metadata';
          const source = document.createElement('source');
          source.src = piece.url;
          source.type = VIDEO_MIME[extOf(piece.url)] ?? 'video/mp4';
          video.appendChild(source);
          video.addEventListener('loadedmetadata', scheduleLayout);
          mediaEl = video;
        } else {
          const img = document.createElement('img');
          img.src = piece.url;
          img.alt = piece.label;
          img.loading = 'lazy';
          img.addEventListener('load', scheduleLayout);
          mediaEl = img;
        }
        mediaEl.addEventListener('error', () => {
          fig.classList.add('media-missing');
          mediaEl.remove();
          scheduleLayout();
        });
        inner.appendChild(mediaEl);

        const caption = document.createElement('figcaption');
        caption.textContent = piece.label;
        inner.appendChild(caption);

        const fallback = document.createElement('div');
        fallback.className = 'media-fallback';
        fallback.textContent = `${piece.label} — unavailable`;
        inner.appendChild(fallback);

        fig.appendChild(inner);
        return fig;
      }

      // ----- Aspect-ratio puzzle layout -----
      const grid = document.getElementById('puzzleGrid');
      const statusEl = document.getElementById('puzzleStatus');

      function naturalRatio(item: Element): number {
        const img = item.querySelector('img');
        if (img && img.naturalWidth && img.naturalHeight) {
          return img.naturalWidth / img.naturalHeight;
        }
        const video = item.querySelector('video');
        if (video && video.videoWidth && video.videoHeight) {
          return video.videoWidth / video.videoHeight;
        }
        return 16 / 9; // default / missing-media fallback
      }

      function columnCount(g: HTMLElement): number {
        return getComputedStyle(g).gridTemplateColumns.split(' ').filter(Boolean).length;
      }

      function layout(): void {
        if (!grid) return;
        const g = grid as HTMLElement;
        const styles = getComputedStyle(g);
        const rowUnit = parseFloat(styles.gridAutoRows) || 8;
        const gap = parseFloat(styles.rowGap) || 0;
        const cols = columnCount(g);
        const items = Array.from(g.querySelectorAll<HTMLElement>('.puzzle-item'));

        // Pass 1: column span from aspect ratio (sets the tile width).
        items.forEach((item) => {
          const ratio = naturalRatio(item);
          let span = 1; // portrait / square
          if (ratio >= 2.4) span = 3; // panoramic
          else if (ratio >= 1.3) span = 2; // landscape
          item.style.gridColumnEnd = `span ${Math.min(span, cols)}`;
        });

        // Pass 2: row span from the now-known rendered height.
        items.forEach((item) => {
          const inner = item.querySelector<HTMLElement>('.puzzle-inner');
          const height = (inner ?? item).getBoundingClientRect().height;
          const rowSpan = Math.max(1, Math.round((height + gap) / (rowUnit + gap)));
          item.style.gridRowEnd = `span ${rowSpan}`;
        });

        g.classList.add('ready');
      }

      let scheduled = false;
      function scheduleLayout(): void {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(() => {
          scheduled = false;
          layout();
        });
      }

      function setStatus(message: string): void {
        if (statusEl) statusEl.textContent = message;
      }

      async function loadPuzzle(): Promise<void> {
        if (!grid) return;
        try {
          const results = await Promise.all(SOURCES.map(listPrefix));
          const pieces = results.flat().sort((a, b) => b.modified - a.modified);

          if (pieces.length === 0) {
            setStatus('No media yet — check back soon.');
            return;
          }

          const frag = document.createDocumentFragment();
          pieces.forEach((p) => frag.appendChild(createItem(p)));
          grid.replaceChildren(frag);
          statusEl?.remove();

          scheduleLayout();
          window.setTimeout(() => grid.classList.add('ready'), 1500); // safety reveal
        } catch (err) {
          console.error(
            '[the-facility] Could not load media from the bucket. Check that the ' +
              'bucket allows anonymous listing (s3:ListBucket) and CORS GET from this ' +
              'origin — see src/pages/games/_GAMES.md.',
            err
          );
          setStatus('Media is taking a break — please check back later.');
        }
      }

      window.addEventListener('resize', scheduleLayout);
      loadPuzzle();

      // ----- Lightbox (event-delegated, so it works for dynamic tiles) -----
      const lightbox = document.getElementById('lightbox');
      const content = document.getElementById('lightboxContent');
      const closeBtn = document.getElementById('lightboxClose');

      function closeLightbox(): void {
        if (!lightbox || !content) return;
        lightbox.classList.remove('open');
        content.innerHTML = '';
      }

      grid?.addEventListener('click', (e) => {
        const item = (e.target as Element).closest('.puzzle-item');
        if (!item || item.classList.contains('media-missing') || !lightbox || !content) return;
        const media = item.querySelector('img, video');
        if (!media) return;
        content.innerHTML = '';
        const clone = media.cloneNode(true) as HTMLElement;
        if (clone instanceof HTMLVideoElement) {
          clone.setAttribute('controls', '');
          clone.removeAttribute('muted');
        }
        content.appendChild(clone);
        lightbox.classList.add('open');
      });

      closeBtn?.addEventListener('click', closeLightbox);
      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      });
    </script>
  </body>
</html>
