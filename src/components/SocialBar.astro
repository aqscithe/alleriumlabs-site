---
// Centered row of social icons for the bottom of a page. Drop <SocialBar /> in
// after a page's main content (before/above its footer). Reuses the same icon
// tiles + styling as the home "Follow Our Journey" block.
import SocialIcons from './SocialIcons.astro';
---
<section class="social-bar" aria-label="Follow Allerium Labs on social media">
	<div class="social-bar__icons">
		<SocialIcons />
	</div>
</section>
