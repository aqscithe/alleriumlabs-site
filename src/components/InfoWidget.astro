---
// Fixed, center-left "section info" widget: a button (with an idle white pulse)
// that reveals contextual info about whichever section is in view. Hidden over
// the hero. PARKED COMPONENT — not currently mounted anywhere; kept intact for
// future reuse. Styles live in global.css (.info-widget / .info-button pulse).
// Drop <InfoWidget /> into a page (after <main>) to bring it back.
---
<aside class="info-widget" id="infoWidget">
  <button class="info-button" id="infoButton" type="button" aria-label="More info about this section" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" />
      <circle cx="12" cy="7.5" r="1.4" fill="currentColor" />
      <line x1="12" y1="11" x2="12" y2="16.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </button>
  <div class="info-panel" id="infoPanel" role="region" aria-label="Section information">
    <span class="info-panel-eyebrow">About this section</span>
    <h4 class="info-panel-title" id="infoPanelTitle"></h4>
    <dl class="info-panel-list" id="infoPanelList"></dl>
    <a class="info-panel-link" id="infoPanelLink"></a>
  </div>
</aside>

<script>
  // Section-info widget: a fixed, center-left button that reveals contextual
  // info about whichever section is currently in view. Hidden over the hero.
  interface SectionInfo {
    title: string;
    items: [string, string][];
    link?: { href: string; label: string };
  }

  const INFO: Record<string, SectionInfo> = {
    currentProject: {
      title: 'The Facility',
      items: [
        ['Status', 'In Development'],
        ['Genre', 'Immersive Sim'],
        ['Engine', 'Unity · DOTS'],
      ],
      link: { href: '/games/the-facility', label: 'Explore the showcase →' },
    },
    devlogSection: {
      title: 'Development Blog',
      items: [
        ['Cadence', 'Monthly'],
        ['Focus', 'Graphics · AI · Systems'],
      ],
      link: { href: '/devlog', label: 'View all devlogs →' },
    },
    connectSection: {
      title: 'Connect & Collaborate',
      items: [
        ['Follow', 'YouTube · Instagram · TikTok'],
        ['Updates', 'X · Bluesky'],
        ['Community', 'Discord (soon)'],
      ],
    },
  };

  const widget = document.getElementById('infoWidget');
  const button = document.getElementById('infoButton');
  const titleEl = document.getElementById('infoPanelTitle');
  const listEl = document.getElementById('infoPanelList');
  const linkEl = document.getElementById('infoPanelLink') as HTMLAnchorElement | null;

  function render(key: string): void {
    const data = INFO[key];
    if (!data || !titleEl || !listEl || !linkEl) return;
    titleEl.textContent = data.title;
    listEl.innerHTML = data.items
      .map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`)
      .join('');
    if (data.link) {
      linkEl.href = data.link.href;
      linkEl.textContent = data.link.label;
    } else {
      linkEl.removeAttribute('href');
      linkEl.textContent = '';
    }
  }

  // Track which content section is in view and update the panel.
  const sections = Object.keys(INFO)
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.4) {
          render(entry.target.id);
        }
      });
    },
    { threshold: [0.4] }
  );
  sections.forEach((s) => sectionObserver.observe(s));

  // Only reveal the widget once the hero/header has scrolled out of view.
  const hero = document.getElementById('heroSection');
  if (hero && widget) {
    const heroObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const pastHero = !entry.isIntersecting;
          widget.classList.toggle('visible', pastHero);
          if (!pastHero) {
            widget.classList.remove('open');
            button?.setAttribute('aria-expanded', 'false');
          }
        });
      },
      { threshold: 0.15 }
    );
    heroObserver.observe(hero);
  }

  // Click: spin the button and toggle the panel.
  button?.addEventListener('click', () => {
    if (!widget) return;
    const open = widget.classList.toggle('open');
    button.setAttribute('aria-expanded', open ? 'true' : 'false');
    button.classList.add('spin');
    window.setTimeout(() => button.classList.remove('spin'), 600);
  });

  // Click outside closes the panel.
  document.addEventListener('click', (e) => {
    if (
      widget &&
      widget.classList.contains('open') &&
      !widget.contains(e.target as Node)
    ) {
      widget.classList.remove('open');
      button?.setAttribute('aria-expanded', 'false');
    }
  });

  // Seed initial content.
  render('currentProject');
</script>
